{
  "name": "qr-decode-encode",
  "description": "Shell scripts for decoding / encoding QR codes.",
  "version": "0.0.0-development",
  "main": "lib/index.js",
  "bin": "lib/bin.js",
  "scripts": {
    "start": "tsx src/bin.ts",
    "decode": "yarn start decode",
    "encode": "yarn start encode",
    "build": "tsc && chmod +x lib/bin.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "yarn test:src",
    "test:src": "/usr/bin/env bash -c '[ \"$(tsx src/bin.ts decode \"$(tsx src/bin.ts encode 'magic_test_string')\")\" == \"magic_test_string\" ]'",
    "test:lib": "/usr/bin/env bash -c '[ \"$(node lib/bin.js decode \"$(node lib/bin.js encode 'magic_test_string')\")\" == \"magic_test_string\" ]'",
    "reformat": "eslint src --fix",
    "clean": "rimraf lib",
    "ci-lint": "run-p lint type-check",
    "ci-test": "run-s test:src build test:lib",
    "semantic-release": "semantic-release",
    "prepare": "husky"
  },
  "license": "MIT",
  "author": "Matt Lubner <matt@mattlubner.com>",
  "dependencies": {
    "javascript-barcode-reader": "^1.0.0",
    "jimp": "^0.22.12",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^13.1.0",
    "@commitlint/config-conventional": "^13.1.0",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-config-typescript": "^3.0.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.3.2",
    "rimraf": "^3.0.2",
    "semantic-release": "^19.0.2"
  },
  "resolutions": {
    "semantic-release/@semantic-release/npm/npm/lock-verify/@iarna/cli/yargs/os-locale/mem": "4.0.0",
    "jimp": "0.22.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mattlubner/qr-decode-encode.git"
  }
}
